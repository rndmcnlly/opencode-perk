{
  "name": "opencode-perk",
  "version": "0.5.0",
  "description": "A minimal afferent channel for a harnessed model: fire a background job, get woken with a conversational turn when it finishes.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "agent",
    "background",
    "afferent"
  ],
  "license": "MIT",
  "author": "Adam Smith <adam@adamsmith.as> (https://adamsmith.as)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rndmcnlly/opencode-perk.git"
  },
  "homepage": "https://github.com/rndmcnlly/opencode-perk#readme",
  "bugs": {
    "url": "https://github.com/rndmcnlly/opencode-perk/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run bundle",
    "build:v2": "tsc -p tsconfig.v2.json",
    "bundle": "esbuild src/index.ts --bundle --format=esm --platform=node --external:@opencode-ai/plugin --outfile=dist/perk.js",
    "build:extension": "esbuild openchamber-extension/panel/main.ts --bundle --format=iife --platform=browser --outfile=openchamber-extension/panel/main.js && esbuild openchamber-extension/service/main.ts --bundle --format=esm --platform=node --outfile=openchamber-extension/service/main.js",
    "typecheck:extension": "tsc -p openchamber-extension/tsconfig.json",
    "clean": "rm -rf dist dist-v2",
    "test": "tsx --test test/*.test.ts",
    "test:v2": "tsx --test test/v2-*.test.ts",
    "check:v2": "npm run build:v2 && npm run test:v2",
    "smoke:v2": "tsx script/v2-load-smoke.ts",
    "demo:v2": "tsx script/v2-live-demo.ts",
    "check": "npm run build && npm run typecheck:extension && npm run build:extension && npm test",
    "refresh:opencode": "rm -rf \"${XDG_CACHE_HOME:-$HOME/.cache}/opencode/packages/opencode-perk@latest\"",
    "prepack": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.14",
    "@opencode/schema": "2.0.14",
    "@openchamber/sdk": "^1.24.0",
    "@opencode-ai/plugin": ">=1.15.0",
    "@types/node": "^22.19.19",
    "esbuild": "^0.28.1",
    "effect": "4.0.0-rc.112",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0"
  }
}
